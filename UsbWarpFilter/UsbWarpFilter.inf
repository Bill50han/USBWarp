; Dedicated capture function driver, selected explicitly on one DEVINST.
[Version]
Signature="$WINDOWS NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49F0-BC3D-A4FF138216D6}
Provider=%Provider%
DriverVer=11/07/2026,2.0.0.0
CatalogFile=UsbWarpFilter.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NT$ARCH$.10.0...19041

[Models.NT$ARCH$.10.0...19041]
%Capture.DeviceDesc%=Capture,USBWarp\Capture

[ControlFlags]
ExcludeFromSelect=*

[DestinationDirs]
Capture.Copy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
UsbWarpFilter.sys=1

[Capture.NT]
CopyFiles=Capture.Copy

[Capture.Copy]
UsbWarpFilter.sys

[Capture.NT.HW]
AddReg=Capture.Security

[Capture.Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Capture.NT.Services]
AddService=UsbWarpFilter,0x00000002,Capture.Service

[Capture.Service]
DisplayName=%Capture.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\UsbWarpFilter.sys

[Capture.NT.Wdf]
KmdfService=UsbWarpFilter,Capture.Wdf

[Capture.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="USBWarp"
DiskName="USBWarp capture driver"
Capture.DeviceDesc="USBWarp captured USB device"
Capture.ServiceDesc="USBWarp target USB capture"
