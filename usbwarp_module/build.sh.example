#!/usr/bin/env bash
set -euo pipefail
# Prepare the matching WSL kernel tree first (make modules_prepare).
# A full kernel build provides Module.symvers for symbol/version checks.
# sudo ln -sfn /home/oh2/WSL2-Linux-Kernel /lib/modules/$(uname -r)/build
cd "$(dirname "$0")"
KBUILD_MODPOST_WARN=1 make "${@}"
